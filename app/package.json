{
  "name": "jhos-importaciones-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "catalog:audit": "node scripts/import-reference-catalog.mjs --check-images",
