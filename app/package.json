    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
